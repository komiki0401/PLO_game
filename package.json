{
  "name": "double-board-plo5",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "dev:online": "wrangler dev --env local --port 8787",
    "build:worker": "tsc -p worker/tsconfig.json && wrangler deploy --env=\"\" --dry-run --outdir dist-worker",
    "deploy:online": "wrangler deploy --env=\"\"",
    "test:online": "vitest run src/online",
    "test:e2e:online": "playwright test --config=playwright.online.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  }
}
